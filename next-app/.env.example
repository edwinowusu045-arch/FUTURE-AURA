# Next.js App Environment Configuration
# Copy this file to .env.local and fill in with your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional: For production Netlify deployment
# NEXT_PUBLIC_API_URL=https://your-api-domain.com
# NEXT_PUBLIC_FRONTEND_URL=https://your-frontend-domain.netlify.app

# Authentication
NEXT_PUBLIC_AUTH_DOMAIN=your-auth-domain.com
